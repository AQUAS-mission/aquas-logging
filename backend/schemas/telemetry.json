{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Telemetry",
  "type": "object",
  "required": ["device_id", "metric", "value"],
  "properties": {
    "device_id": { "type": "string" },
    "metric": { "type": "string" },
    "value": { "type": "number" },
    "ts": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
