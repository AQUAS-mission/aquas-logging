# Copy to backend/.env and adjust, or just export these in your shell.
# The API reads them at startup via os.getenv, with the defaults shown here.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aquas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Comma-separated origins allowed to call the API (CORS).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# REQUIRED. HS256 key used to verify the dashboard's API bearer tokens.
# Must be byte-identical to NEXTAUTH_SECRET in frontend/.env.local, or every
# request to /views/query comes back 401. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=dev-only-secret-not-for-production
