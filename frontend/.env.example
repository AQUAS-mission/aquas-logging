# Copy to frontend/.env.local (which is gitignored) before running `npm run dev`.

# NextAuth needs both of these. Generate a real secret with: openssl rand -base64 32
# NEXTAUTH_SECRET also signs the bearer token sent to the API, so it must match
# the backend's NEXTAUTH_SECRET exactly or every data panel 401s.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-only-secret-not-for-production

# The single hardcoded account the credentials provider accepts.
# There is no user table -- login is a string comparison against these two values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Where the FastAPI backend is reachable from the browser.
# Falls back to http://localhost:8000 if unset.
NEXT_PUBLIC_API_BASE=http://localhost:8000
